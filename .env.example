# Hecho por Ismael Cuadrado, Oscar Roldan y Daniel Antolin

# URL real del repositorio GitHub del proyecto.
# Ejemplo: https://github.com/ORDDaw/ProyectoAMPSIS.git
GIT_REPO_URL=https://github.com/ORDDaw/ProyectoAMPSIS.git

# Rama que se clonara en cada ejecucion de vagrant provision.
GIT_BRANCH=main

# Carpeta del repositorio donde estan todos los temas de WordPress.
THEMES_SOURCE_PATH=src/themes

# Tema que se activara automaticamente en WordPress.
ACTIVE_THEME=webfusion-home

# Puerto del WordPress dentro de la maquina virtual.
# Vagrant lo publica en el equipo local como http://localhost:8080
WORDPRESS_PORT=8080

# Credenciales de la base de datos.
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=wordpress
MYSQL_ROOT_PASSWORD=rootpassword